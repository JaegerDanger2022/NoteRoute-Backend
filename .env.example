# App
APP_ENV=development
DEBUG=false

# MongoDB Atlas
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=noteroute

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Pinecone
PINECONE_API_KEY=pc-...
PINECONE_INDEX_NAME=noteroute-slots

# AWS
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_TRANSCRIBE_BUCKET=noteroute-audio

# Bedrock
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
CLAUDE_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Internal services
LANGGRAPH_INTERNAL_URL=http://noteroute-langgraph.railway.internal:8001

# OAuth — Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://your-backend.railway.app/api/v1/integrations/notion/callback

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend.railway.app/api/v1/integrations/google/callback

# OAuth — Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-backend.railway.app/api/v1/integrations/slack/callback

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081
